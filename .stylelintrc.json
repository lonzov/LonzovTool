{
  "overrides": [
    {
      "files": ["**/*.vue"],
      "customSyntax": "postcss-html"
    }
  ],
  "rules": {
    "declaration-property-value-disallowed-list": {
      "/^(color|background|background-color|border|border-color|border-top-color|border-right-color|border-bottom-color|border-left-color|outline-color|text-decoration-color|caret-color|fill|stroke)$/": [
        "/#[0-9a-fA-F]{3,8}\\b/",
        "/rgba?\\(\\s*[0-9]/"
      ]
    }
  }
}
